# Optional AI key. Without it, the app runs fully offline using deterministic
# demo fallbacks. Never commit a real key.
#
# DeepSeek (default):
#   DEEPSEEK_API_KEY=sk-...
#   TOAST_LLM_MODEL=deepseek-v4-flash
#   DEEPSEEK_BASE_URL=https://api.deepseek.com
#
# OpenAI (alternative): set OPENAI_API_KEY, AI_BASE_URL=https://api.openai.com/v1,
#   and AI_MODEL=gpt-4o-mini.
DEEPSEEK_API_KEY=
TOAST_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
